# Copy to .env and fill in, or export directly in your shell.

# Recommended: Free, fast LLM API key from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Alternative providers:
# OPENCODE_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Optional — defaults shown (auto-detected based on provider).
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.3-70b-versatile
# LLM_TIMEOUT=30.0

# Optional — SQLite database location (defaults to ./data/triage.db).
# Set this to a persistent volume path in production (e.g. Railway / Render volume).
# TRIAGE_DB_PATH=/data/triage.db

