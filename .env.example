# Copy to .env and fill in, or export directly in your shell.

# Required — LLM provider API key (OpenCode Zen / OpenAI-compatible).
# Multiple keys: comma-separate them; the classifier auto-fails over to the
# next key when one is rate-limited (429) or revoked (401).
# OPENCODE_API_KEY=key1,key2,key3
OPENCODE_API_KEY=your_key_here

# Optional — defaults shown.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL_NAME=deepseek-v4-flash-free

# Optional — SQLite database location (defaults to ./data/triage.db).
# Set this to a persistent volume path in production (e.g. Railway volume).
# TRIAGE_DB_PATH=/data/triage.db
